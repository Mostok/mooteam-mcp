{
  "name": "mooteam-mcp",
  "version": "0.3.0",
  "description": "Moo.team MCP: GET-only task context, search, compact local history, participant roles and in-memory attachments.",
  "type": "module",
  "bin": {
    "mooteam-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build",
    "smoke": "node scripts/smoke.mjs",
    "release:version": "npm version --no-git-tag-version"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mooteam",
    "moo.team",
    "tasks"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mostok/mooteam-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/Mostok/mooteam-mcp/issues"
  },
  "homepage": "https://github.com/Mostok/mooteam-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@napi-rs/canvas": "^1.0.9",
    "pdfjs-dist": "^6.3.289",
    "saxes": "^6.0.0",
    "yauzl": "^3.4.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/yauzl": "^3.4.0",
    "typescript": "^5.9.3"
  }
}
